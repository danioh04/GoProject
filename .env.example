ADDR=:8080

LOG_LEVEL=info
LOG_FORMAT=text

# Optional: Server-side Google Maps API key
GOOGLE_MAPS_API_KEY=

# Optional: Postgres connection string (empty disables persistence)
# Local docker default: postgres://scope:scope@localhost:5432/scope?sslmode=disable
DATABASE_URL=

MAX_PLAYERS=8
ROUNDS=5
ROUND_SECONDS=60
REVEAL_SECONDS=10
