ADDR=:8080

LOG_LEVEL=info
LOG_FORMAT=text

# Optional: Server-side Google Maps API key for dynamic Street View discovery
GOOGLE_MAPS_API_KEY=

# Optional: PostgreSQL DSN (empty disables database persistence)
DATABASE_URL=postgres://prism:prism@localhost:5432/prism?sslmode=disable

MAX_PLAYERS=8
ROUNDS=5
ROUND_SECONDS=60
REVEAL_SECONDS=10
