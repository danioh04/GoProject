# GeoDuel Configuration

# Server listen address
ADDR=:8080

# Logging settings
LOG_LEVEL=info
LOG_FORMAT=text

# Google Maps API Key (Public key for client 360° Street View panoramas)
GOOGLE_MAPS_API_KEY=

# Custom GeoJSON Map Pack (Optional - defaults to embedded world map)
MAP_FILE=

# PostgreSQL Persistence (Optional - leave empty for in-memory only)
DATABASE_URL=postgres://geoduel:geoduel@localhost:5432/geoduel?sslmode=disable

# Match settings
MAX_ROOM_SIZE=8
ROUNDS=5
ROUND_SECONDS=60
REVEAL_SECONDS=10

# Debug and Metrics Server (Optional, e.g. :6060)
DEBUG_ADDR=